# Copy to .env next to docker-compose.yml and fill in. Never commit .env.

# ---- Palworld server ----
SERVER_NAME=My Palworld Server
SERVER_DESCRIPTION=
# Leave empty for no join password.
SERVER_PASSWORD=
# Required. Also the password PalOps uses for the REST API (Settings → Server connection).
ADMIN_PASSWORD=
PLAYERS=16
# true lists the server in the in-game community browser (also open 27015/udp).
COMMUNITY=false
# Time zone for backups and for the panel's restart times, e.g. Europe/Paris or America/New_York.
TZ=UTC
# Optional overrides (defaults shown).
# BACKUP_CRON_EXPRESSION=0 * * * *
# OLD_BACKUP_DAYS=3
# Restarts and world saves are set in the panel: Server → Restarts and saves.

# ---- PalOps ----
# Your website's domain, e.g. play.example.com. Caddy uses it for HTTPS.
PALOPS_DOMAIN=

# openssl rand -hex 32. Keep it forever: it encrypts the saved Palworld admin password.
PANEL_SECRET=

# Discord application (Developer Portal > OAuth2). Add the redirect below to the portal too.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://play.example.com/api/v1/auth/discord/callback

# Optional. Used once to create the owner. If unset, a token is printed in `docker compose logs palops`.
PANEL_SETUP_TOKEN=

# What the public website shows players.
SITE_JOIN_ADDRESS=play.example.com:8211
SITE_DISCORD_INVITE=
