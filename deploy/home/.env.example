# Copy to .env next to docker-compose.yml and fill in. Never commit .env.

# ---- Palworld server ----
SERVER_NAME=My Palworld Server
SERVER_DESCRIPTION=
# Leave empty for no join password.
SERVER_PASSWORD=
# Required. Also the password PalOps uses for the REST API (Settings → Server connection).
ADMIN_PASSWORD=
PLAYERS=16
# true lists the server in the in-game community browser (also forward 27015/udp).
COMMUNITY=false
# Time zone for backups and for the panel's restart times, e.g. Europe/Paris or America/New_York.
TZ=UTC
# Optional overrides (defaults shown).
# BACKUP_CRON_EXPRESSION=0 * * * *
# OLD_BACKUP_DAYS=3

# ---- Cloudflare Tunnel (HTTPS for the website and panel) ----
# Zero Trust → Networks → Tunnels → Create a tunnel (Cloudflared) → copy the token.
CLOUDFLARE_TUNNEL_TOKEN=

# ---- PalOps ----
# openssl rand -hex 32. Keep it forever: it encrypts the saved Palworld admin password.
PANEL_SECRET=

# Discord application (Developer Portal > OAuth2). Add the redirect below to the portal too.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://play.example.com/api/v1/auth/discord/callback

# Optional. Used once to create the owner. If unset, a token is printed in `docker compose logs palops`.
PANEL_SETUP_TOKEN=

# Optional. Owner sign-in for when Discord sign-in is broken (16+ characters: openssl rand -base64 24).
PANEL_EMERGENCY_PASSWORD=

# What the public website shows players: your public IP (or a DDNS name, or the playit address) and the game port.
SITE_JOIN_ADDRESS=
SITE_DISCORD_INVITE=

# ---- Optional: playit.gg UDP tunnel (only if you can't forward 8211/udp) ----
PLAYIT_SECRET_KEY=
