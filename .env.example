# Copy to server/.env (or set these in your environment).

# development | production
NODE_ENV=development
HOST=0.0.0.0
PORT=8080

# SQLite database file. The directory is created if missing.
DATABASE_PATH=./data/panel.db

# Required in production: at least 32 random characters, e.g. `openssl rand -hex 32`.
# Used to encrypt stored server credentials. Changing it makes saved credentials unreadable.
# In development a secret is generated next to the database if this is unset.
PANEL_SECRET=

# Optional: preset the one-time token for creating the owner account.
# If unset, a random token is printed to the log on first start.
PANEL_SETUP_TOKEN=

# --- Discord sign-in (primary) ---
# Create an application at https://discord.com/developers/applications, then under OAuth2
# copy the Client ID and Client Secret and add the redirect URI below (it must match exactly).
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# e.g. https://panel.example.com/api/v1/auth/discord/callback
# (for local development: http://localhost:5173/api/v1/auth/discord/callback)
# Staff (/panel) and players (/) both sign in through this one redirect.
DISCORD_REDIRECT_URI=

# Username/password sign-in. Defaults to false when Discord is configured, true otherwise.
AUTH_PASSWORD_LOGIN=

# Emergency sign-in: lets you in as the owner with this password even when Discord sign-in
# or password sign-in is off or broken. At least 16 characters (openssl rand -base64 24).
# Leave empty to turn it off. Every use is recorded in the audit log and the console.
PANEL_EMERGENCY_PASSWORD=

# --- Public website ---
# Address players type in Palworld to join, shown on the website.
SITE_JOIN_ADDRESS=
# Community Discord invite link shown on the website.
SITE_DISCORD_INVITE=
# Set false to hide the online player list on the website.
SITE_SHOW_ONLINE_PLAYERS=true

# --- World data ---
# Seconds between world snapshots (guilds, map, signals). Needs -enable-gamedata-api on the server. 0 turns it off.
WORLD_POLL_SECONDS=10

# --- Development only (rejected unless NODE_ENV=development) ---
# Local stand-in page for Discord sign-in, so no Discord app is needed.
DEV_DISCORD_LOGIN=false
# Connect the built-in mock Palworld server on start if no server is configured.
DEV_MOCK_SERVER=false

# Sessions end after this much inactivity, and always after SESSION_MAX_DAYS.
SESSION_IDLE_HOURS=12
SESSION_MAX_DAYS=7

# auto = secure cookies in production only. Set true whenever the panel is served over HTTPS.
COOKIE_SECURE=auto

# Set true when running behind a reverse proxy (nginx, Caddy, Traefik) so client IPs
# and the forwarded host are read from X-Forwarded-* headers.
TRUST_PROXY=false

# Where the built frontend lives, relative to the server directory.
WEB_DIST_PATH=../web/dist

LOG_LEVEL=info
